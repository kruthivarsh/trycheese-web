# Server-only settings for the /delete-account form. They are read only in
# src/app/(info)/delete-account/actions.ts; never give them a NEXT_PUBLIC_ prefix.
# In Vercel, set both for the Production environment only, then redeploy.

# The trycheese API. Optional: defaults to https://api.trycheese.app.
TRYCHEESE_API_URL=

# The same value as WEB_API_KEY on the trycheese_be server. Without it the form
# says deleting on the website isn't working right now.
TRYCHEESE_WEB_API_KEY=
